# Copy to .env.local to change anything. Nothing here is secret: every
# VITE_ value ends up in the browser.

# Where the app calls the API. The default goes through the dev server's
# proxy (and, in production, the same origin as the app).
VITE_API_URL=/api

# Development only: where the dev server's proxy sends /api.
BACKEND_URL=http://localhost:3000
