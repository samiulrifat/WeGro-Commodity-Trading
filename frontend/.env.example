# Copy to .env.local to change anything. Nothing here is secret: every
# VITE_ value ends up in the browser.

# Where the backend is. Empty (the default): the same origin as the app,
# which the dev server proxies to the backend. API paths start with /api.
VITE_API_ORIGIN=

# Development only: where the dev server's proxy sends /api.
BACKEND_URL=http://localhost:3000
