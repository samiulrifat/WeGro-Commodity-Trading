{
  "name": "wegro-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint --type-aware src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\"",
    "api:generate": "rtk-query-codegen-openapi openapi-config.cjs && node scripts/generate-codes.mjs && prettier --write src/api/generated --log-level warn",
    "test": "vitest run",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-bengali": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-router": "1.170.41",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "react-redux": "^9.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "6.2.5",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
