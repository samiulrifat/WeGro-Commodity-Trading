# Copy to .env and fill in. Every variable the backend reads is listed here
# with its default; the app refuses to start if a required one is missing or
# malformed (see src/config/env.validation.ts).
#
# Generate the secrets with:
#   openssl rand -hex 32      # IDENTITY_MASTER_KEY (exactly 64 hex characters)
#   openssl rand -base64 48   # JWT_SECRET, PAYMENT_REF_SECRET (32+ characters each)

# --- Server ---
NODE_ENV=development
PORT=3000
# Origins allowed to call the API, comma-separated (the frontend).
CORS_ORIGINS=http://localhost:5173
# The frontend's address; QR codes on receipts and batches link under it.
PUBLIC_APP_URL=http://localhost:5173
# Interactive API docs at /docs.
SWAGGER_ENABLED=true
# One ready-made, verified account per role with password-free sign-in.
# For demos only: refused when NODE_ENV=production.
DEMO_MODE=false
# Who sends text messages (password reset codes): log writes them to the
# backend log for local work; memory keeps them for tests. Production needs a
# real SMS provider (none added yet) and refuses both.
SMS_PROVIDER=log

# --- Database (required) ---
DATABASE_URL=postgres://commodity_user:choose_a_password@localhost:5432/commodity_db

# --- Sign-in (required: JWT_SECRET) ---
JWT_SECRET=replace-with-at-least-32-random-characters
# Access token lifetime: a number with s, m or h.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
# Requests per client per window, and sign-in attempts per client per minute.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_THROTTLE_LIMIT=10

# --- Secrets for personal data and payments (required) ---
# Encrypts personal details and keys their search indexes. Losing it makes
# stored personal details unreadable: back it up.
IDENTITY_MASTER_KEY=replace-with-64-hex-characters
# Keys the hash of payment references written to the ledger.
PAYMENT_REF_SECRET=replace-with-at-least-32-random-characters

# --- Blockchain ---
CHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Every person's key is derived from this 12- or 24-word seed (index 0 is the
# operator and super admin, and must be the account that deployed the
# contracts). Locally: Hardhat's test phrase (see the README). Anywhere else:
# a new secret phrase, kept like a password.
KEY_MASTER_MNEMONIC=replace-with-a-bip39-phrase
# Test currency (wei) sent to a new key so it can pay fees; 0 turns funding
# off (a network with free gas).
KEY_FUNDING_WEI=1000000000000000000
# Hardhat Ignition deployment folder with the contract addresses.
CONTRACTS_DEPLOYMENT_DIR=../contracts/ignition/deployments/chain-31337
TX_CONFIRMATIONS=1
TX_TIMEOUT_MS=30000

# --- Copying ledger events into the database ---
INDEXER_ENABLED=true
INDEXER_POLL_MS=1000
# Largest block range per pass (it shrinks by itself after a failure).
INDEXER_BATCH_BLOCKS=2000
# Blocks to stay behind the head; 0 on instant-finality chains.
INDEXER_CONFIRMATIONS=0
# Block to start from; leave unset to find the deployment block automatically.
# CHAIN_START_BLOCK=

# --- Background jobs ---
JOBS_ENABLED=true
# Release reservations, sales and deals past their ledger deadline.
EXPIRY_SWEEP_MS=60000
# Send deadline, inactivity and expiring-storage reminders.
REMINDER_SWEEP_MS=300000
# Check the database keeps up with the ledger; tell admins past the lag.
WATCHDOG_INTERVAL_MS=300000
WATCHDOG_LAG_BLOCKS=100

# --- Files ---
# Uploaded photos (field records, claims, bills, consent forms).
UPLOAD_DIR=./uploads

# --- Optional, read only by the command-line scripts ---
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_PHONE=
# SUPER_ADMIN_PASSWORD=
